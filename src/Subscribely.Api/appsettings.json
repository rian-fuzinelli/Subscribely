{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Catalog": "",
    "PostgresAdmin": "",
    "Redis": ""
  },
  "TenantDatabase": {
    "ConnectionTemplate": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Outbox": {
    "DispatcherEnabled": true,
    "PollingInterval": "00:00:02",
    "BatchSize": 50
  },
  "Jobs": {
    "ServerEnabled": true,
    "RecurringJobsEnabled": true
  }
}
