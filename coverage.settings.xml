<?xml version="1.0" encoding="utf-8"?>
<!-- Cobertura (Microsoft.Testing.Extensions.CodeCoverage): só o código de produção do Subscribely, sem migrations e código gerado (logging, OpenAPI). -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*Subscribely\.(SharedKernel|Infrastructure|Modules\..*|Api)\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*Tests\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[\\/]Migrations[\\/].*</Source>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
