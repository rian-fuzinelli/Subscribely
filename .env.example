# Copie para .env (gitignored) e troque os valores. Usado pelo docker-compose.yml.
POSTGRES_PASSWORD=change-me-postgres
APP_DB_PASSWORD=change-me-app
PROVISIONER_DB_PASSWORD=change-me-provisioner
# Chave HMAC do JWT: no mínimo 32 bytes (ex.: openssl rand -base64 48)
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-of-at-least-32-bytes
FAKE_GATEWAY_WEBHOOK_SECRET=change-me-webhook-secret
